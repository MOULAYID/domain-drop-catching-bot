# Copy this file to .env and fill in your key:  cp .env.example .env
# Then load it before running:  set -a; . ./.env; set +a
# NEVER commit .env and never paste the key into dropcatch.py.

# Required. Dynadot > Tools > API > unlock account > Production Key.
export DYNADOT_API_KEY="paste-your-production-key-here"

# Set to 1 to test against https://api-sandbox.dynadot.com with your
# Sandbox Key instead of spending real money.
export DYNADOT_SANDBOX="0"

# Registration length per catch (years). 1 is what you want for drop catching.
export DYNADOT_DURATION="1"

# Optional currency override (USD, EUR, ...). Blank = account default.
export DYNADOT_CURRENCY="USD"
